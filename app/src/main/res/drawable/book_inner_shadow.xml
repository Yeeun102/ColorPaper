<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="50dp"
        android:gravity="end">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#42000000"
                android:startColor="#00000000" />
        </shape>
    </item>
    <item
        android:height="50dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#42000000"
                android:startColor="#00000000" />
        </shape>
    </item>
</layer-list>
