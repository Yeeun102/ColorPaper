<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ColorPaper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="materialCardViewStyle">@style/Widget.ColorPaper.SoftCard</item>
        <item name="materialButtonStyle">@style/Widget.ColorPaper.SoftButton</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.ColorPaper.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.ColorPaper.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.ColorPaper.Large</item>
    </style>

    <style name="Widget.ColorPaper.SoftCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/soft_card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/soft_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ColorPaper.SoftButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/soft_button_corner_radius</item>
        <item name="strokeColor">@color/soft_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ShapeAppearance.ColorPaper.Small" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">@dimen/soft_small_corner_radius</item>
    </style>

    <style name="ShapeAppearance.ColorPaper.Medium" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/soft_button_corner_radius</item>
    </style>

    <style name="ShapeAppearance.ColorPaper.Large" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">@dimen/soft_card_corner_radius</item>
    </style>

    <!-- 스플래시 테마 -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- 스플래시 배경색 (원하는 색으로 바꿔!) -->
        <item name="windowSplashScreenBackground">#FFFFFF</item>

        <!-- 중앙에 들어갈 로고 이미지 (res/drawable 안에 있는 이미지 이름) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>

        <!-- 스플래시가 끝나고 넘어갈 원래 메인 테마 이름 지정 -->
        <item name="postSplashScreenTheme">@style/Base.Theme.ColorPaper</item>
    </style>
  
    <style name="Theme.ColorPaper" parent="Base.Theme.ColorPaper" />

    <style name="HomeBottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/bottom_nav_item_vertical_padding</item>
        <item name="android:paddingBottom">@dimen/bottom_nav_item_vertical_padding</item>
    </style>

    <style name="HomeBottomNavIconContainer">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
    </style>

    <style name="HomeBottomNavIcon">
        <item name="android:layout_width">@dimen/bottom_nav_icon_size</item>
        <item name="android:layout_height">@dimen/bottom_nav_icon_size</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:tint">@color/theme_rose_stroke</item>
    </style>

    <style name="CalendarWeekday">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/theme_rose_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
