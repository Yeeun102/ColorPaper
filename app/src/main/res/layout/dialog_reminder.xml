<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tv_reminder_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#332B2B"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_reminder_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#FFF5D7"
        android:padding="14dp"
        android:textColor="#544747"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/layout_reminder_masking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/group_masking_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_mask_touch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="@string/masking_touch_mode" />

            <RadioButton
                android:id="@+id/radio_mask_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/masking_input_mode" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layout_masking_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_masking_answer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/masking_answer_hint"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/btn_masking_check"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/masking_check" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_masking_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_reminder_answer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="top|start"
        android:hint="@string/reminder_answer_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:minHeight="96dp"
        android:padding="12dp" />

</LinearLayout>
