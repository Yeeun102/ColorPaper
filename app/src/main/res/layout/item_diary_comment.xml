<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="0dp"
    android:paddingStart="0dp"
    android:paddingEnd="0dp">

    <!-- 댓글 포스트잇 SVG 배경 -->
    <ImageView
        android:id="@+id/ivCommentBg"
        android:layout_width="150dp"
        android:layout_height="130dp"
        android:scaleType="fitXY"
        android:src="@drawable/comment_blue"
        android:contentDescription="@string/comment_postit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 완료 버튼 -->
    <TextView
        android:id="@+id/btnCommentDone"
        android:layout_width="30dp"
        android:layout_height="15dp"
        android:layout_marginTop="35dp"
        android:layout_marginEnd="12dp"
        android:text="@string/sendComment"
        android:textSize="11sp"
        android:textColor="#000000"
        android:gravity="center"
        android:background="#FAFAFA"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="@id/ivCommentBg"
        app:layout_constraintEnd_toEndOf="@id/ivCommentBg" />

    <!-- 댓글 입력 본문 -->
    <EditText
        android:id="@+id/etCommentContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="32dp"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="댓글 입력..."
        android:textSize="13sp"
        android:textColor="#333333"
        android:inputType="textMultiLine"
        android:maxLines="4"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="@id/ivCommentBg"
        app:layout_constraintBottom_toBottomOf="@id/ivCommentBg"
        app:layout_constraintStart_toStartOf="@id/ivCommentBg"
        app:layout_constraintEnd_toEndOf="@id/ivCommentBg"/>

    <!-- 댓글 단 시간/상대 날짜 표시 (예: 오늘, 2일 전) -->
    <TextView
        android:id="@+id/tvCommentTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="today"
        android:textSize="10sp"
        android:textColor="#666666"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="14dp"
        app:layout_constraintBottom_toBottomOf="@id/ivCommentBg"
        app:layout_constraintEnd_toEndOf="@id/ivCommentBg"/>

    <!-- 작성자 프로필 + 이름 클릭 컨테이너 -->
    <LinearLayout
        android:id="@+id/layoutCommentAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="2dp"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="@id/ivCommentBg"
        app:layout_constraintStart_toStartOf="@id/ivCommentBg">

        <!-- 동그란 프로필 이미지 (14dp로 변경) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCommentProfile"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <!-- 작성자 이름 (날짜와 동일한 10sp, #666666 적용) -->
        <TextView
            android:id="@+id/tvCommentAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="작성자"
            android:textColor="#666666"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 이모지 댓글 전용 텍스트뷰 -->
    <TextView
        android:id="@+id/tvCommentEmoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="💬"
        android:textColor="#3F2F2F"
        android:textSize="38sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btnDeleteComment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_dialog_btn_delete"
        android:backgroundTint="#FF8A8A"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="삭제"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/ivCommentBg"
        app:layout_constraintStart_toStartOf="@id/ivCommentBg"
        app:layout_constraintTop_toBottomOf="@id/ivCommentBg"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>