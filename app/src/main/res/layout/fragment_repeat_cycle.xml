<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1F1"
    android:padding="24dp">

    <!-- 좌측 상단 뒤로가기 버튼 -->
    <ImageView
        android:id="@+id/iv_back_repeat_cycle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/tv_repeat_cycle_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="반복주기설정"
        android:textColor="#333333"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/iv_back_repeat_cycle"
        app:layout_constraintBottom_toBottomOf="@id/iv_back_repeat_cycle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 첫 번째 카드: 기본 설정 (이것만 고정!) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_default_cycle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#F9F6F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/iv_back_repeat_cycle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="기본"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- 둥근 버튼(칩)들 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="10분"
                    android:textColor="#333333"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="1일"
                    android:textColor="#333333"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="일주일"
                    android:textColor="#333333"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="20dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="1달"
                    android:textColor="#333333"
                    app:strokeColor="#CCCCCC"
                    app:cornerRadius="20dp"
                    android:minWidth="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 나중에 사용자가 추가한 카드가 들어갈 빈 공간 -->
    <LinearLayout
        android:id="@+id/ll_custom_cycles_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/cv_default_cycle" />

    <!-- 사용자 지정 추가 플러스 버튼 -->
    <ImageView
        android:id="@+id/iv_add_custom_cycle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#333333"
        app:layout_constraintTop_toBottomOf="@id/ll_custom_cycles_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>