<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_personal_info_group"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F1F1"
    android:padding="24dp">

    <!-- 좌측 상단 뒤로가기 버튼 -->
    <ImageView
        android:id="@+id/iv_back_personal_info"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/baseline_arrow_back_ios_24"
        app:tint="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 개인정보 메뉴 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_personal_info_menu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardBackgroundColor="#F9F6F6"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toBottomOf="@id/iv_back_personal_info">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <!-- 8.1.1 개인정보변경 -->
            <TextView
                android:id="@+id/tv_edit_personal_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp"
                android:text="개인정보변경"
                android:textColor="#333333"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

            <!-- 8.1.2 로그아웃 -->
            <TextView
                android:id="@+id/tv_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp"
                android:text="로그아웃"
                android:textColor="#333333"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

            <!-- 8.1.3 회원탈퇴 -->
            <TextView
                android:id="@+id/tv_withdraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp"
                android:paddingVertical="20dp"
                android:text="회원탈퇴"
                android:textColor="#333333"
                android:textSize="16sp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>