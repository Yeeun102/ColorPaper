<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.profile.ProfileEditFragment">

    <!-- 상단 타이틀바 (뒤로가기 & 타이틀) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:contentDescription="뒤로가기"
            android:src="@drawable/baseline_arrow_back_ios_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="프로필 수정하기"
            android:textColor="#8B5A5A"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 중앙 프로필 수정 카드 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:cardBackgroundColor="#F5E6E6"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="#D1B8B8"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 프로필 사진 구역 (원형 적용) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEditProfileImage"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_report_image"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="#8B5A5A"
                app:strokeWidth="1.5dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="프로필 사진 변경"
                android:textColor="#8B5A5A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 닉네임 입력 구역 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="닉네임"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2D0D0"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etNickname"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="닉네임을 입력하세요"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 사용자 아이디 입력 (user_code 매핑) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="사용자 아이디"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2D0D0"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/etUserCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="아이디를 입력하세요"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 저장 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSave"
        android:layout_width="140dp"
        android:layout_height="50dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="32dp"
        android:text="저장"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#8B5A5A"
        app:cornerRadius="12dp"
        app:elevation="2dp" />

</LinearLayout>