<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- 메인 스크롤 뷰 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 상단 툴바 (뒤로가기, 유저코드, 검색) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentStart="true"
                    android:src="@android:drawable/ic_menu_revert"
                    android:contentDescription="뒤로가기" />

                <TextView
                    android:id="@+id/tvUserCodeTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="#0000"
                    android:textSize="18sp"
                    android:textStyle="italic|bold"
                    android:textColor="#8B5A5A" />

                <ImageView
                    android:id="@+id/ivSearchFriend"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:src="@android:drawable/ic_menu_search"
                    android:contentDescription="친구검색" />
            </RelativeLayout>

            <!-- 프로필 카드 메인 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#F5E6E6"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#D1B8B8"
                app:strokeWidth="1.5dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivProfileImage"
                        android:layout_width="75dp"
                        android:layout_height="75dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_report_image"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                        app:strokeColor="#8B5A5A"
                        app:strokeWidth="1.5dp" />

                    <LinearLayout
                        android:id="@+id/llUserInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivProfileImage"
                        android:layout_marginStart="16dp"
                        android:layout_centerVertical="true">

                        <TextView
                            android:id="@+id/tvNickname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            tools:text="나으닝"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#000000" />

                        <TextView
                            android:id="@+id/tvFollowerCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="팔로워 0"
                            android:textSize="13sp"
                            android:textColor="#555555"
                            android:layout_marginTop="4dp"
                            android:padding="2dp" />

                        <TextView
                            android:id="@+id/tvFollowingCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="팔로잉 0"
                            android:textSize="13sp"
                            android:textColor="#555555"
                            android:padding="2dp" />
                    </LinearLayout>

                    <!-- 상단 프로필 수정 버튼 (내 프로필용) -->
                    <ImageView
                        android:id="@+id/ivEditProfile"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:src="@android:drawable/ic_menu_edit"
                        android:contentDescription="프로필수정" />

                    <!-- 로그아웃 버튼 (alignParentBottom 제거 및 위치 조정) -->
                    <TextView
                        android:id="@+id/btnLogout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_below="@id/ivEditProfile"
                        android:layout_marginTop="8dp"
                        android:text="로그아웃"
                        android:textColor="#FF5252"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp"
                        android:visibility="gone"/>

                    <!-- 팔로우 버튼 (타인 프로필용) -->
                    <TextView
                        android:id="@+id/btnFollowToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_follow_btn"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="8dp"
                        android:text="팔로우"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- 친구 업데이트 뱃지 -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardFriendUpdateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:visibility="gone"
                        app:cardBackgroundColor="#E2C2C2"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#D1B8B8"
                        app:strokeWidth="1dp">

                        <TextView
                            android:id="@+id/tvFriendUpdateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="6dp"
                            android:text="친구 업데이트 3건"
                            android:textColor="#4A3B3B"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1B8B8"
                android:layout_marginTop="16dp"/>

            <!-- 하이라이트 구역 -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"
                android:layout_marginTop="16dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1B8B8"
                android:layout_marginTop="16dp"/>

            <!-- 공유 단어장 구역 -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEmptySharedFlashcard"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:visibility="visible"
                    app:cardBackgroundColor="#F2E6E6"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#E2D0D0"
                    app:strokeWidth="1.5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="공유 중인 단어장이 없습니다"
                        android:textColor="#8C7676"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </com.google.android.material.card.MaterialCardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSharedFlashcards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clipToPadding="false"
                    android:paddingStart="0dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1B8B8"
                android:layout_marginTop="16dp"/>

            <!-- 다이어리 커버 -->
            <LinearLayout
                android:id="@+id/llSharedDiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="80dp"
                android:gravity="center_horizontal">

                <RelativeLayout
                    android:layout_width="180dp"
                    android:layout_height="240dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="165dp"
                        android:layout_height="240dp"
                        android:layout_alignParentEnd="true"
                        app:cardBackgroundColor="#5C1D1D"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="3dp"
                        app:strokeColor="#3D1212"
                        app:strokeWidth="1.5dp"/>

                    <LinearLayout
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="24dp">
                        <View android:layout_width="22dp" android:layout_height="4dp" android:background="#000000" android:layout_marginBottom="10dp"/>
                        <View android:layout_width="22dp" android:layout_height="4dp" android:background="#000000" android:layout_marginBottom="10dp"/>
                        <View android:layout_width="22dp" android:layout_height="4dp" android:background="#000000"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="25dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_alignParentBottom="true"
                        android:layout_marginBottom="24dp">
                        <View android:layout_width="22dp" android:layout_height="4dp" android:background="#000000" android:layout_marginBottom="10dp"/>
                        <View android:layout_width="22dp" android:layout_height="4dp" android:background="#000000"/>
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="28dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="#5C1D1D"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp"
                        app:strokeColor="#1F0808"
                        app:strokeWidth="1.5dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                app:cardBackgroundColor="#A88B8B"
                                app:cardCornerRadius="6dp"
                                app:cardElevation="0dp"
                                app:strokeColor="#3D1212"
                                app:strokeWidth="1dp"/>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                </RelativeLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 팔로워 / 팔로잉 팝업 레이어 -->
    <FrameLayout
        android:id="@+id/flFriendListPopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPopupContent"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_gravity="center"
            android:layout_marginHorizontal="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="10dp"
            app:strokeColor="#D1B8B8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvPopupTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        tools:text="팔로워 목록"
                        android:textColor="#8B5A5A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/ivClosePopup"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:contentDescription="닫기" />
                </RelativeLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="#E2D0D0" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPopupFriendList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

</FrameLayout>