<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="0dp">

    <!-- 💡 포스트잇 SVG 배경을 깔아주는 곳 -->
    <ImageView
        android:id="@+id/ivPostItShadow"
        android:layout_width="230dp"
        android:layout_height="176dp"
        android:alpha="0.10"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/post_yellow"
        android:tint="#000000"
        android:translationX="4dp"
        android:translationY="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivPostItBg"
        android:layout_width="230dp"
        android:layout_height="176dp"
        android:scaleType="fitXY"
        android:src="@drawable/post_yellow"
        android:contentDescription="@string/postit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <View
        android:id="@+id/postItSoftBorder"
        android:layout_width="224dp"
        android:layout_height="170dp"
        android:background="@drawable/postit_soft_border"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/ivPostItBg"
        app:layout_constraintTop_toTopOf="@id/ivPostItBg" />

    <View
        android:id="@+id/postItDragHandle"
        android:layout_width="180dp"
        android:layout_height="20dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/postit_drag_handle"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@id/ivPostItBg"
        app:layout_constraintStart_toStartOf="@id/ivPostItBg"
        app:layout_constraintTop_toTopOf="@id/ivPostItBg" />

    <!-- 날짜 라벨 (와이어프레임 내부 6월 30일 표기용) -->
    <TextView
        android:id="@+id/tvPostItDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/today"
        android:textSize="13sp"
        android:textColor="#333333"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="@id/postItDragHandle"
        app:layout_constraintEnd_toEndOf="@id/postItDragHandle"
        app:layout_constraintStart_toStartOf="@id/postItDragHandle"
        app:layout_constraintTop_toTopOf="@id/postItDragHandle"/>

    <!-- 일기 내용을 입력하는 칸 -->
    <EditText
        android:id="@+id/etPostItContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@android:color/transparent"
        android:gravity="top|start"
        android:hint="@string/entryHint"
        android:autofillHints="@string/entryHint"
        android:textSize="14sp"
        android:textColor="#222222"
        app:layout_constraintTop_toBottomOf="@id/tvPostItDate"
        app:layout_constraintBottom_toBottomOf="@id/ivPostItBg"
        app:layout_constraintStart_toStartOf="@id/ivPostItBg"
        app:layout_constraintEnd_toEndOf="@id/ivPostItBg"/>

    <!-- 와이어프레임 우측 하단의 삭제/설정용 카메라 혹은 이미지 버튼
    <ImageButton
        android:id="@+id/btnPostItMenu"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_camera"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="@id/ivPostItBg"
        app:layout_constraintEnd_toEndOf="@id/ivPostItBg"
        android:contentDescription="@string/postit_menu" />-->

</androidx.constraintlayout.widget.ConstraintLayout>
