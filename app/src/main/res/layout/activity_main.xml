<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_rose_background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginStart="@dimen/bottom_nav_horizontal_margin"
        android:layout_marginEnd="@dimen/bottom_nav_horizontal_margin"
        android:layout_marginBottom="@dimen/bottom_nav_bottom_margin"
        app:cardBackgroundColor="@color/theme_rose_checklist"
        app:cardCornerRadius="@dimen/bottom_nav_corner_radius"
        app:cardElevation="3dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/theme_rose_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <LinearLayout android:id="@+id/nav_flashcard" style="@style/HomeBottomNavItem">
                <FrameLayout style="@style/HomeBottomNavIconContainer">
                    <View
                        android:id="@+id/indicator_flashcard"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <ImageView
                        android:id="@+id/icon_flashcard"
                        style="@style/HomeBottomNavIcon"
                        android:contentDescription="@string/quick_action_open"
                        android:src="@drawable/ic_nav_reminder" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_diary" style="@style/HomeBottomNavItem">
                <FrameLayout style="@style/HomeBottomNavIconContainer">
                    <View
                        android:id="@+id/indicator_diary"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <ImageView
                        android:id="@+id/icon_diary"
                        style="@style/HomeBottomNavIcon"
                        android:contentDescription="개별 날짜 메모"
                        android:src="@drawable/ic_nav_book" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_home" style="@style/HomeBottomNavItem">
                <FrameLayout style="@style/HomeBottomNavIconContainer">
                    <View
                        android:id="@+id/indicator_home"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <ImageView
                        android:id="@+id/icon_home"
                        style="@style/HomeBottomNavIcon"
                        android:contentDescription="홈"
                        android:src="@drawable/ic_nav_home" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_profile" style="@style/HomeBottomNavItem">
                <FrameLayout style="@style/HomeBottomNavIconContainer">
                    <View
                        android:id="@+id/indicator_profile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <ImageView
                        android:id="@+id/icon_profile"
                        style="@style/HomeBottomNavIcon"
                        android:contentDescription="프로필"
                        android:src="@drawable/ic_nav_profile" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/nav_setting" style="@style/HomeBottomNavItem">
                <FrameLayout style="@style/HomeBottomNavIconContainer">
                    <View
                        android:id="@+id/indicator_setting"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <ImageView
                        android:id="@+id/icon_setting"
                        style="@style/HomeBottomNavIcon"
                        android:contentDescription="설정"
                        android:src="@drawable/ic_nav_setting" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_quick_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_nav_overlay_depth"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true"
        android:scaleX="0.92"
        android:scaleY="0.92"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/bottom_navigation_bar"
        app:layout_constraintEnd_toEndOf="@id/bottom_navigation_bar"
        app:layout_constraintStart_toStartOf="@id/bottom_navigation_bar"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/layout_quick_action_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/quick_action_fade_headroom"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/quick_action_reminder"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/icon_quick_reminder"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_reminder" />

                <TextView
                    android:id="@+id/tv_quick_reminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/quick_action_reminder"
                    android:textColor="@color/theme_rose_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/quick_action_flashcard"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/icon_quick_flashcard"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nav_memo" />

                <TextView
                    android:id="@+id/tv_quick_flashcard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/quick_action_flashcard"
                    android:textColor="@color/theme_rose_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/bottom_nav_overlay_depth"
                android:importantForAccessibility="no" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
