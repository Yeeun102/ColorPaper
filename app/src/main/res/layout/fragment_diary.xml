<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:padding="16dp">

    <!-- Linear Layout  -->
    <LinearLayout
        android:id="@+id/layoutDateSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/lineHeader">

        <TextView
            android:id="@+id/tvDateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/example_date"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333" />

        <ImageButton
            android:id="@+id/btnDatePicker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_my_calendar"
            android:contentDescription="@string/selectDate" />
    </LinearLayout>

    <View
        android:id="@+id/lineHeader"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/layoutDateSelect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivFixedDiaryPage"
        android:layout_width="0dp"
        android:layout_height="500dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/diarypage"
        android:contentDescription="@string/diarypage"
        app:layout_constraintTop_toBottomOf="@id/lineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <FrameLayout
        android:id="@+id/layoutDiaryContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="54dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="@id/ivFixedDiaryPage"
        app:layout_constraintEnd_toEndOf="@id/ivFixedDiaryPage"
        app:layout_constraintStart_toStartOf="@id/ivFixedDiaryPage"
        app:layout_constraintTop_toTopOf="@+id/ivFixedDiaryPage">

        <TextView
            android:id="@+id/tvEmptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/entryHint"
            android:textColor="#999999"
            android:textSize="16sp" />
    </FrameLayout>

    <!-- 하단 부가 제어선: 전체공개, 하이라이트, 저장 -->
    <LinearLayout
        android:id="@+id/layoutMetaActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="120dp"
        android:paddingEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/ivFixedDiaryPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHighlightState"
            style="?android:attr/buttonBarStyle"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="@string/highlight"
            android:textSize="15sp"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            android:backgroundTint="#D5B4B4"
            android:textColor="#111111"
            android:layout_marginEnd="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="?android:attr/buttonBarStyle"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:text="@string/save"
            app:strokeColor="#000000"
            app:strokeWidth="1dp"
            android:backgroundTint="#867070"/>
    </LinearLayout>
    <!-- 하단 툴바 1: 꾸미기 용도 (포스트잇추가, 형광펜, 텍스트, 이모지, 댓글) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutToolbarDecorate"
        android:layout_width="360dp"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        app:cardBackgroundColor="#E4D0D0"
        app:cardCornerRadius="@dimen/bottom_nav_corner_radius"
        app:layout_constraintTop_toBottomOf="@id/layoutMetaActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:strokeColor="@color/theme_rose_stroke"
        app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <ImageButton
            android:id="@+id/btnToolbarAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="@string/createEmptyPostit" />

        <ImageButton
            android:id="@+id/btnToolbarPen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="@string/highlight" />

        <ImageButton
            android:id="@+id/btnToolbarText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/ic_menu_sort_alphabetically"
            android:contentDescription="@string/enterText" />

        <ImageButton
            android:id="@+id/btnToolbarComment"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:src="@android:drawable/sym_action_chat"
            android:contentDescription="@string/self_comment" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutPostItSetting"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_comment_btn"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <!-- 색상 및 저장 버튼 바 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvSettingColorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/colour"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_toEndOf="@id/tvSettingColorLabel"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true">
                <View android:id="@+id/viewColorOrange" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:background="#FFB6A6"/>
                <View android:id="@+id/viewColorYellow" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:background="#FFEBD3"/>
                <View android:id="@+id/viewColorGreen" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="8dp" android:background="#9BCEC1"/>
                <View android:id="@+id/viewColorBlue" android:layout_width="24dp" android:layout_height="24dp" android:background="#67A2C5"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettingSave"
                style="?android:attr/buttonBarStyle"
                android:layout_width="100dp"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp"
                android:text="@string/save"
                android:textColor="#000000"
                android:backgroundTint="#FFFCCF"
                android:gravity="center"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- 태그 라인 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="@string/tag"
                android:textStyle="bold"
                android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipTagDaily"
                style="?android:attr/buttonBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp"
                android:text="@string/tag_daily"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:backgroundTint="#FFCDCD"
                android:textColor="#000000"
                android:layout_marginEnd="8dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chipTagWork"
                style="?android:attr/buttonBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp"
                android:text="@string/tag_work"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:backgroundTint="#EECDFF"
                android:textColor="#000000"
                android:layout_marginEnd="8dp"/>
            <LinearLayout
                android:id="@+id/layoutDynamicTagsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>

            <!-- 태그 추가 + 버튼 -->
                <ImageView
                    android:id="@+id/btnAddCustomTag"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_input_add"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="2dp"
                    android:contentDescription="@string/add_tag" />
        </LinearLayout>

        <!-- 감정 라인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/feeling"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <LinearLayout
                    android:id="@+id/layoutSelectedEmotionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="0dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectEmotion"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/select"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:backgroundTint="#EDEDED"
                    android:textColor="#000000"/>
            </LinearLayout>

        <!-- 반복주기 라인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_cycle"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatAuto"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/repeat_auto"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#ECECEC"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatUser"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/repeat_user"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#D2FFDA"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRepeatNone"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/repeat_none"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#F0E2B4"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="알림 시간"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReminderTime"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:insetBottom="0dp"
                    android:insetTop="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="0dp"
                    android:text="오후 8:00"
                    android:textColor="#000000"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        <!-- 종료일자 라인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/end_date"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEndDateNone"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:paddingHorizontal="12dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/repeat_none"
                    android:textSize="15sp"
                    android:textColor="#000000"
                    android:backgroundTint="#F0E2B4"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEndDateUser"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/repeat_user"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#D2FFDA"/>
            </LinearLayout>

        <!-- 공개범위 라인 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:text="@string/f_visibility"
                    android:textStyle="bold"
                    android:textColor="#000000"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisibilityPublic"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/flashcard_public"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#DFD5FF"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisibilityFriendOnly"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/flashcard_onlyF"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#D7E7FF"
                    android:layout_marginEnd="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnVisibilityPrivate"
                    style="?android:attr/buttonBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minHeight="0dp"
                    android:paddingVertical="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:strokeColor="#000000"
                    app:strokeWidth="1dp"
                    android:text="@string/flashcard_private"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:textColor="#000000"
                    android:backgroundTint="#FFD7D7"/>
            </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEmotionPopup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_emotion"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="@id/layoutPostItSetting"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feeling"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmotionPopupConfirm"
                style="?android:attr/buttonBarStyle"
                android:minHeight="0dp"
                android:paddingVertical="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="1dp"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="@string/confirm"
                android:textSize="17sp"
                android:textColor="#000000"
                android:backgroundTint="#FFFCCF"
                android:gravity="center"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <!-- 감정 그리드/태그 배열 (요청하신 감정 키워드 4개씩 3줄 임베딩) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            style="?android:attr/buttonBarStyle">
            <com.google.android.material.button.MaterialButton android:id="@+id/emo1"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="100dp" android:layout_weight="1" android:layout_height="34dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:strokeColor="#000000" app:strokeWidth="1dp"
                android:text="@string/sharp_happy"
                android:backgroundTint="#FFFDD0"
                android:layout_marginEnd="4dp" android:textSize="11sp" android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/emo2"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="100dp" android:layout_weight="1" android:layout_height="34dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:strokeColor="#000000" app:strokeWidth="1dp"
                android:text="@string/sharp_excited"
                android:backgroundTint="#FFB348"
                android:layout_marginEnd="4dp" android:textSize="11sp" android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/emo3"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="100dp" android:layout_weight="1" android:layout_height="34dp"
                android:text="@string/sharp_satisfied"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:strokeColor="#000000" app:strokeWidth="1dp"
                android:backgroundTint="#FFA4C8"
                android:layout_marginEnd="4dp" android:textSize="11sp" android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/emo4"
                style="?android:attr/buttonBarStyle"
                android:layout_width="100dp" android:layout_weight="1" android:layout_height="34dp"
                android:text="@string/sharp_relaxed"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:strokeColor="#000000" app:strokeWidth="1dp"
                android:backgroundTint="#E1FF48"
                android:textSize="11sp" android:textColor="#000000"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/emo5"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="100dp" android:layout_weight="1" android:layout_height="34dp"
                android:text="@string/sharp_annoyed"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="4dp"
                app:strokeColor="#000000" app:strokeWidth="1dp"
                android:backgroundTint="#BEFFBA"
                android:layout_marginEnd="4dp" android:textSize="11sp" android:textColor="#000000"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/emo6"
                style="?android:attr/buttonBarButtonStyle"
